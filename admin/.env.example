# Copy to .env for local dev. On Railway, set these as service variables instead.

# Railway sets PORT itself; 8870 is the local default.
PORT=8870

# token-service base URL. Local: http://localhost:8880. Deployed: the droplet's Caddy host,
# e.g. https://space.example.com
TOKEN_SERVICE_URL=http://localhost:8880

# Must equal ADMIN_SHARED_SECRET in token-service/.env (NOT TOKEN_SERVICE_SHARED_SECRET).
ADMIN_SHARED_SECRET=

# The operator login password for this page. Generate one: openssl rand -hex 16
ADMIN_PASSWORD=
