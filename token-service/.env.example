# Copy to .env for local dev.

PORT=8880

# Must match whatever livekit-server is actually running with (see ../README.md).
# Local dev default is the fixed LiveKit --dev credentials.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# Shared secret for service-to-service auth. Any caller (e.g. Petition Studio's API) must send
# `Authorization: Bearer <this value>`. Generate a real one for anything beyond local dev:
# openssl rand -hex 32
TOKEN_SERVICE_SHARED_SECRET=change-me-to-a-long-random-string
