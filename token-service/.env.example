# Copy to .env for local dev.

PORT=8880

# Must match whatever livekit-server is actually running with (see ../README.md).
# Local dev default is the fixed LiveKit --dev credentials.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# Shared secret for service-to-service auth. Any caller (e.g. test-call, Petition Studio's API)
# must send `Authorization: Bearer <this value>`. Must match test-call/.env for local/Codespaces
# start-all.sh. Generate a real one for anything beyond local dev: openssl rand -hex 32
TOKEN_SERVICE_SHARED_SECRET=local-dev-secret-not-for-production

# Separate secret for the operator-only /admin/* routes (remove participants, close rooms, delete
# recordings). Only the admin app holds it -- never give it to a consumer like test-call or
# Petition Studio. Empty = /admin/* answers 500. start-all.sh generates one on a VPS.
ADMIN_SHARED_SECRET=

# The LiveKit URL browsers are told to connect to (returned as serverUrl by POST /token). Leave
# unset locally; on a deployment behind Caddy set it to the public wss:// host, e.g.
# LIVEKIT_PUBLIC_URL=wss://space.example.com

# Where LiveKit should POST egress status updates for recordings this service starts. Must be
# reachable from wherever livekit-server itself runs -- localhost works because both run natively
# on the same machine in local dev (see ../egress/README or config.yaml for the Docker side).
# RECORDING_WEBHOOK_URL=http://localhost:8880/recording/webhook

# Internal compressor service that shrinks a finished recording before it's kept. Not
# LAN-reachable by design -- see ../compressor/.
# COMPRESSOR_URL=http://127.0.0.1:8890

# Host-side path egress/raw resolves to. Only needed if you moved the egress/ directory
# or are running token-service from somewhere other than this repo's token-service/ folder.
# EGRESS_RAW_DIR=/absolute/path/to/egress/raw
