# Copy to .env for local dev.

PORT=8880

# Must match whatever livekit-server is actually running with (see ../README.md).
# Local dev default is the fixed LiveKit --dev credentials.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880

# Shared secret for service-to-service auth. Any caller (e.g. the demo app, Petition Studio's API)
# must send `Authorization: Bearer <this value>`. Must match demo/.env for local
# start-all.sh. Generate a real one for anything beyond local dev: openssl rand -hex 32
TOKEN_SERVICE_SHARED_SECRET=local-dev-secret-not-for-production

# Separate secret for the operator-only /admin/* routes (remove participants, close rooms, delete
# recordings). Only the /admin control center (demo's /admin routes) holds it -- never a consumer's call
# path, never Petition Studio. Empty = /admin/* answers 500. start-all.sh generates one on a VPS.
ADMIN_SHARED_SECRET=

# The LiveKit URL browsers are told to connect to (returned as serverUrl by POST /token). Leave
# unset locally; on a deployment behind Caddy set it to the public wss:// host, e.g.
# LIVEKIT_PUBLIC_URL=wss://space.example.com

# VPS only: hostname for LiveKit's built-in TURN relay (callers on networks that only allow
# HTTPS). Needs its own DNS A record and Caddy's layer4 route (deploy/Caddyfile). start-all.sh
# adds the turn: block to .runtime/livekit.yaml when this is set.
# TURN_DOMAIN=turn.space.example.com

# Every call is recorded by default: the first person to join starts the room's recording (it can
# still be stopped, and then stays off for that call). Set to 0 to record only on request.
# RECORD_ALL_CALLS=1

# Soniox API key (console.soniox.com). When set, every finished recording is transcribed (async
# stt-async-v5, speakers separated) into egress/transcripts/. Server-side only: never put it in the
# demo or a browser. SONIOX_REGION=eu|jp|in keeps processing in that region (needs a regional
# project and its own key).
# SONIOX_API_KEY=

# Languages the calls are likely in, comma-separated ISO codes, e.g. en,ur. Unset = detect any.
# TRANSCRIPTION_LANGUAGE_HINTS=en,ur

# Words the calls use that Soniox should expect (names, acronyms), comma-separated, e.g. USCIS,NIW.
# TRANSCRIPTION_TERMS=

# Opus bitrate (kbps) egress records at. Egress writes the finished file at this rate directly; there
# is no second compression pass. Speech stays clear well below music bitrates.
# RECORDING_AUDIO_KBPS=24

# Host-side path egress/raw resolves to. Only needed if you moved the egress/ directory
# or are running token-service from somewhere other than this repo's token-service/ folder.
# EGRESS_RAW_DIR=/absolute/path/to/egress/raw
