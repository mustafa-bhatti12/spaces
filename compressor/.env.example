# Copy to .env for local dev. All fields optional -- sensible defaults shown.

PORT=8890

# Where raw egress output lands and where compressed output should go. Defaults to
# ../egress/{raw,compressed} relative to this service -- matching the -v mount egress:/out
# in the docker run command for the egress worker.
# RAW_DIR=../egress/raw
# COMPRESSED_DIR=../egress/compressed
# Opus target bitrate. Speech-only audio stays intelligible well below music bitrates.
# COMPRESS_BITRATE=24k
