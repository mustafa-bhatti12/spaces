# Copy to .env.local for local dev. On Railway, set these as service variables instead.

# token-service base URL. Local: http://localhost:8880. Deployed: the droplet's Caddy host,
# e.g. https://spaces.example.com
TOKEN_SERVICE_URL=http://localhost:8880

# The call website's own token-service credential: the `spaces-web` app's hsk_ key (scopes: tokens:mint,
# rooms:read, rooms:end, recordings:control; it cannot create rooms). Deployed: issue it in /admin -> Apps.
# Local: ./start-all.sh issues one into demo/.env on first run (or: cd token-service && npm run issue-key -- spaces-web).
TOKEN_SERVICE_APP_KEY=

# Operator control center at /admin. Both empty = /admin disabled.
# ADMIN_SHARED_SECRET must equal token-service's ADMIN_SHARED_SECRET (NOT the app key above).
ADMIN_SHARED_SECRET=
ADMIN_PASSWORD=

# Set to 1 when a TLS-terminating proxy (Railway, Caddy) is the only way in, so the admin login rate
# limit keys on the real client IP from X-Forwarded-For. Leave unset when clients reach Next directly.
TRUST_PROXY=

# Comma-separated origins allowed to frame /embed (and talk to its bridge), e.g.
# https://hof-petition-studio-web-production.up.railway.app
EMBED_ALLOWED_ORIGINS=
