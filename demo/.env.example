# Copy to .env.local for local dev. On Railway, set these as service variables instead.

# token-service base URL. Local: http://localhost:8880. Deployed: the droplet's Caddy host,
# e.g. https://spaces.example.com
TOKEN_SERVICE_URL=http://localhost:8880

# Consumer secret: must equal TOKEN_SERVICE_SHARED_SECRET in token-service/.env.
TOKEN_SERVICE_SHARED_SECRET=local-dev-secret-not-for-production

# Operator control center at /admin. Both empty = /admin disabled.
# ADMIN_SHARED_SECRET must equal token-service's ADMIN_SHARED_SECRET (NOT the consumer secret above).
ADMIN_SHARED_SECRET=
ADMIN_PASSWORD=

# Set to 1 when a TLS-terminating proxy (Railway, Caddy) is the only way in, so the admin login rate
# limit keys on the real client IP from X-Forwarded-For. Leave unset when clients reach Next directly.
TRUST_PROXY=
